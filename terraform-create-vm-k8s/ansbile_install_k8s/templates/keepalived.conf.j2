vrrp_instance VI_1 {
    state MASTER
    interface {{ interface }}
    virtual_router_id 51
    priority 100
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass 42
    }
    virtual_ipaddress {
        {{ vip }}
    }
    track_script {
        chk_haproxy
    }
    vrrp_script chk_haproxy {
    script "killall -0 haproxy"
    interval 2
    weight 2
    }
}
